# Ignore node_modules folders in the root and any subdirectories (like frontend)
node_modules/

# Ignore environment variables files. These contain secrets!
.env
.env*.local

# Ignore log files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore build output folders
/backend/dist
/build
/dist

# Frontend specific build output
/frontend/dist
/frontend/.next
/frontend/.svelte-kit
/frontend/.output

# Ignore user-uploaded files. You don't want to commit user data to your repo.
# It's better to store these in a cloud service like S3 in production.
/backend/uploads/

# Ignore IDE/editor configuration files
.vscode/
.idea/

# Ignore macOS system files
.DS_Store

# Ignore temporary files
*.tmp
*.swp